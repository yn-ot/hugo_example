diff a/layouts/evenements/list.html b/layouts/evenements/list.html
--- a/layouts/evenements/list.html	1970-01-01 01:00:00.000000000 +0100
+++ b/layouts/evenements/list.html	2026-09-23 18:53:45.014207100 +0200
@@ -0,0 +1,31 @@
+{{- /* AJOUT LOCAL (voir VENDORED.md) : agenda de la section « evenements ».
+       À venir (triés par date de l'événement, le plus proche en premier), puis passés.
+       « Maintenant » = moment de la construction du site (à chaque publication). */ -}}
+{{ define "main" }}
+  {{ .Content }}
+  {{ $now := now }}
+  {{ $upcoming := slice }}
+  {{ $past := slice }}
+  {{ range .Pages }}
+    {{ $ref := or .Params.event_end .Params.event_date }}
+    {{ if and $ref ((time.AsTime $ref).After $now) }}
+      {{ $upcoming = $upcoming | append . }}
+    {{ else }}
+      {{ $past = $past | append . }}
+    {{ end }}
+  {{ end }}
+  <h2>À venir</h2>
+  {{ if $upcoming }}
+    {{ range sort $upcoming "Params.event_date" "asc" }}
+      {{ partial "event-item.html" . }}
+    {{ end }}
+  {{ else }}
+    <p>Aucun événement n'est programmé pour le moment. Revenez bientôt !</p>
+  {{ end }}
+  {{ with $past }}
+    <h2>Événements passés</h2>
+    {{ range sort . "Params.event_date" "desc" }}
+      {{ partial "event-item.html" . }}
+    {{ end }}
+  {{ end }}
+{{ end }}
diff a/layouts/evenements/single.html b/layouts/evenements/single.html
--- a/layouts/evenements/single.html	1970-01-01 01:00:00.000000000 +0100
