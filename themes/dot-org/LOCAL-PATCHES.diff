diff a/layouts/partials/cover.html b/layouts/partials/cover.html
--- a/layouts/partials/cover.html	1970-01-01 01:00:00.000000000 +0100
+++ b/layouts/partials/cover.html	2026-09-27 22:57:13.491309500 +0200
@@ -0,0 +1,15 @@
+{{- /* AJOUT LOCAL (voir VENDORED.md) : image de couverture d'un bundle.
+       Usage : partial "cover.html" (dict "page" . "size" "800x" "loading" "lazy")
+       Lit le front matter `image` (ou `featured_image`) : nom d'un fichier placé à côté de index.md. */ -}}
+{{- $p := .page }}
+{{- $size := .size }}
+{{- $loading := .loading | default "lazy" }}
+{{- with $p.Resources.GetMatch (or $p.Params.image $p.Params.featured_image "-") }}
+  {{- $img := . }}
+  {{- if and (eq .ResourceType "image") (in (slice "jpeg" "png" "webp") .MediaType.SubType) }}
+    {{- with $size }}{{ $w := int (strings.TrimSuffix "x" .) }}{{ if gt $img.Width $w }}{{ $img = $img.Resize . }}{{ end }}{{ end }}
+    <img src="{{ $img.RelPermalink }}" width="{{ $img.Width }}" height="{{ $img.Height }}" alt="{{ $p.Params.image_alt | default "" }}" loading="{{ $loading }}">
+  {{- else }}
+    <img src="{{ .RelPermalink }}" alt="{{ $p.Params.image_alt | default "" }}" loading="{{ $loading }}">
+  {{- end }}
+{{- end }}
diff a/layouts/partials/event-item.html b/layouts/partials/event-item.html
--- a/layouts/partials/event-item.html	1970-01-01 01:00:00.000000000 +0100
+++ b/layouts/partials/event-item.html	2026-09-23 18:53:44.918474000 +0200
@@ -0,0 +1,9 @@
+{{- /* AJOUT LOCAL : un événement dans une liste */ -}}
+<article class="blog-item event-item">
+  {{- with partial "cover.html" (dict "page" . "size" "800x") }}
+  <a class="blog-item__cover" href="{{ $.RelPermalink }}" tabindex="-1" aria-hidden="true">{{ . }}</a>
+  {{- end }}
+  <h3 class="blog-item__title h2"><a href="{{ .RelPermalink }}">{{ .Title }}</a></h3>
+  {{ partial "event-meta.html" . }}
+  <p class="blog-item__summary">{{ .Summary | plainify }}</p>
+</article>
diff a/layouts/partials/event-meta.html b/layouts/partials/event-meta.html
--- a/layouts/partials/event-meta.html	1970-01-01 01:00:00.000000000 +0100
+++ b/layouts/partials/event-meta.html	2026-09-23 18:53:44.977292000 +0200
@@ -0,0 +1,22 @@
+{{- /* AJOUT LOCAL : date, heure et lieu d'un événement (front matter event_date, event_end, lieu) */ -}}
+{{- with .Params.event_date }}
+{{- $start := time.AsTime . }}
+{{- $end := "" }}{{ with $.Params.event_end }}{{ $end = time.AsTime . }}{{ end }}
+{{- $sameDay := and $end (eq ($end | time.Format "2006-01-02") ($start | time.Format "2006-01-02")) }}
+<p class="event-meta">
+  <span class="event-meta__date">{{ $start | time.Format "Monday 2 January 2006" }}</span>
+  {{- if ne ($start | time.Format "15:04") "00:00" }}
+    <span class="event-meta__time">
+      {{- if $sameDay -}}
+        de {{ $start | time.Format "15h04" }} à {{ $end | time.Format "15h04" }}
+      {{- else -}}
+        à {{ $start | time.Format "15h04" }}
+      {{- end -}}
+    </span>
+  {{- end }}
+  {{- if and $end (not $sameDay) }}
+    <span class="event-meta__end">jusqu'au {{ $end | time.Format ":date_long" }}</span>
+  {{- end }}
+  {{- with $.Params.lieu }}<span class="event-meta__place">{{ . }}</span>{{ end }}
+</p>
+{{- end }}
