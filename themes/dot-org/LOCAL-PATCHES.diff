diff a/layouts/partials/page-title.html b/layouts/partials/page-title.html
--- a/layouts/partials/page-title.html	1970-01-01 01:00:00.000000000 +0100
+++ b/layouts/partials/page-title.html	2026-09-23 18:53:44.965541300 +0200
@@ -0,0 +1,4 @@
+{{- /* AJOUT LOCAL (voir VENDORED.md) : titre de la page tel qu'affiché (h1, <title>).
+       La page 404 a un titre anglais codé en dur dans Hugo (« 404 Page not found », non configurable) :
+       on lui substitue la chaîne i18n `not_found_title`. */ -}}
+{{- if eq .Kind "404" }}{{ i18n "not_found_title" | default "Page introuvable" }}{{ else }}{{ .Title }}{{ end -}}
